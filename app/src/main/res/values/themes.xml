<resources>
    <style name="Theme.BioGestureControl" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/brand_navy</item>
        <item name="colorSecondary">@color/brand_cyan</item>
        <item name="colorSecondaryVariant">@color/brand_cyan</item>
        <item name="colorOnSecondary">@color/brand_navy</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:statusBarColor">@color/brand_navy_deep</item>
        <item name="android:navigationBarColor">@color/brand_navy_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/brand_blue</item>
    </style>

    <style name="Widget.BioGesture.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/brand_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BioGesture.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_navy</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand_blue</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/white</item>
    </style>

    <style name="Widget.BioGesture.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BioGesture.SegmentedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/segmented_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/segmented_background</item>
        <item name="strokeColor">@color/segmented_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BioGesture.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@color/brand_outline</item>
    </style>

    <style name="TextAppearance.BioGesture.SectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BioGesture.GestureRow" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_gesture_row</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BioGesture.GestureRow.Compact" parent="TextAppearance.BioGesture.GestureRow">
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
