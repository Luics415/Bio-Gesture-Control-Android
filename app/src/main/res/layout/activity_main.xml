<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BioGesture Control"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Concede permiso de Cámara.\n2. Concede permiso de Superposición.\n3. Presiona abajo para activar el servicio."
        android:gravity="center"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btn_enable_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACTIVAR SERVICIO EN AJUSTES" />

</LinearLayout>